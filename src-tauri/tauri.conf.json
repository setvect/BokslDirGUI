{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BokslDir",
  "mainBinaryName": "BokslDirGUI",
  "version": "0.1.1",
  "identifier": "com.boksldir.gui",
  "build": {
    "beforeDevCommand": "npm run archive:prepare && npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run archive:prepare && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "복슬Dir",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      },
      {
        "label": "drop-overlay",
        "title": "복슬Dir file drop overlay",
        "url": "drop-overlay.html",
        "width": 1,
        "height": 1,
        "visible": false,
        "focus": false,
        "focusable": false,
        "transparent": true,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "windows": {
      "nsis": {
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/archive-tools/": "archive-tools/",
      "vendor/drag/LICENSE_APACHE-2.0": "licenses/drag/LICENSE_APACHE-2.0",
      "vendor/drag/LICENSE_MIT": "licenses/drag/LICENSE_MIT",
      "vendor/drag/PATCH.md": "licenses/drag/PATCH.md"
    }
  }
}
