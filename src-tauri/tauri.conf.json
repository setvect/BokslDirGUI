{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BokslDirGUI",
  "mainBinaryName": "BokslDirGUI",
  "version": "0.1.0",
  "identifier": "com.boksldir.gui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "BokslDirGUI",
        "width": 1280,
        "height": 820,
        "minWidth": 1080,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      },
      {
        "label": "drop-overlay",
        "title": "BokslDirGUI file drop overlay",
        "url": "drop-overlay.html",
        "width": 1,
        "height": 1,
        "visible": false,
        "focus": false,
        "focusable": false,
        "transparent": true,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
