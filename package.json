{
  "name": "boksldir-gui",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "BokslDirGUI desktop file manager built with Tauri, React, TypeScript, and Rust.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test scripts/test-feature-tools.mjs",
    "check": "npm run typecheck && cargo check --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "verify:providers": "node scripts/check-platform-providers.mjs",
    "verify:scope": "node scripts/verify-full-scope.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run check && npm run rust:test && npm run verify:scope && npm run docs:check",
    "docs:generate": "node scripts/generate-docs.mjs",
    "docs:check": "node scripts/generate-docs.mjs --check",
    "archive:prepare": "node scripts/prepare-archive-tools.mjs"
  },
  "dependencies": {
    "@crabnebula/tauri-plugin-drag": "^2.1.0",
    "@dnd-kit/core": "^6.3.1",
    "@radix-ui/react-context-menu": "^2.3.0",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-popover": "^1.1.16",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.2",
    "@tauri-apps/api": "2.11.0",
    "i18next": "^26.3.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-i18next": "^17.0.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.2",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "jsdom": "^29.1.1",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "4.1.8"
  },
  "engines": {
    "node": ">=24"
  }
}
